# ── PostgreSQL / PostGIS ─────────────────────────────
# Stores EVENT, ROAD_DEFECT, INFRA_ASSET, TRAFFIC_OBS, INCIDENT,
# PLATE, ROADTWIN_STATE, MAINTENANCE and all spatial queries.
POSTGRES_DB=urbansense
POSTGRES_USER=urbansense
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://urbansense:change_me@localhost:5432/urbansense

# ── Redis ────────────────────────────────────────────
# Caches Fusion Engine intermediate state and Copilot query results.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible object storage) ────────────
# Stores evidence crops/clips referenced by EVENT.evidence_ref
# and pre/post-incident video buffers.
MINIO_ROOT_USER=urbansense
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_EVIDENCE=urbansense-evidence
MINIO_USE_SSL=false

# ── MQTT Broker (Mosquitto) ──────────────────────────
# Edge → backend event transport, priority-routed P0 (instant)
# through P3 (buffered batch sync).
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9002
MQTT_USERNAME=urbansense
MQTT_PASSWORD=change_me
MQTT_TOPIC_EVENTS=urbansense/events

# ── Backend API (FastAPI) ────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── RBAC ─────────────────────────────────────────────
# Comma-separated roles that may access /incidents and ANPR/PLATE data.
RBAC_RESTRICTED_ROLES=police,admin

# ── GenAI Authority Copilot ──────────────────────────
# LLM used for NLP intent parsing → deterministic SQL tool calls.
LLM_PROVIDER=anthropic
LLM_API_KEY=change_me
LLM_MODEL=claude-sonnet-4-6

# ── GIS Dashboard (React + TypeScript) ───────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILE_PROVIDER=maplibre
